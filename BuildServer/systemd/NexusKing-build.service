[Unit]
Description=NexusKing Theos Build Server
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=bnexusking
Group=bnexusking
SupplementaryGroups=docker
EnvironmentFile=/etc/NexusKing-build.env
Environment=HOME=/var/lib/NexusKing-build
Environment=DOCKER_CONFIG=/var/lib/NexusKing-build/.docker
ExecStart=/usr/bin/python3 /opt/NexusKing-build/src/BuildServer/server/build_server.py
Restart=always
RestartSec=3

# Hardening: the API process can only write its own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/NexusKing-build
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
